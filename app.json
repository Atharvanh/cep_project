{
  "expo": {
    "name": "WelNest",
    "slug": "welnest",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.welnest.prototype"
    },
    "android": {
      "adaptiveIcon": {
        "backgroundColor": "#337a6b",
        "foregroundImage": "./assets/android-icon-foreground.png"
      },
      "predictiveBackGestureEnabled": false,
      "package": "com.welnest.prototype",
      "permissions": [
        "android.permission.CAMERA"
      ]
    },
    "web": {
      "favicon": "./assets/favicon.png",
      "name": "WelNest — A little better, every day"
    },
    "plugins": [
      "expo-font",
      [
        "expo-camera",
        {
          "cameraPermission": "Allow WelNest to scan food product barcodes.",
          "recordAudioAndroid": false,
          "barcodeScannerEnabled": true
        }
      ],
      "expo-sharing"
    ],
    "extra": {
      "eas": {
        "projectId": "441e5929-8318-4484-a415-9ac0409918e9"
      }
    },
    "owner": "atharvanh"
  }
}
